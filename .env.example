# FalkorDB — prefer a single connection URL (use falkors:// for TLS)
# FALKORDB_URL=falkors://username:password@host:6379

# Or discrete fields instead of FALKORDB_URL
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false
# FALKORDB_CA_CERT=/path/to/ca.pem

FALKORDB_SOCKET_TIMEOUT=30
FALKORDB_CONNECT_TIMEOUT=5
FALKORDB_MAX_CONNECTIONS=10
FALKORDB_HEALTH_CHECK_INTERVAL=30

# AWS S3 for screenshots (credentials via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY or ~/.aws/credentials)
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_PREFIX=ui-screenshots
S3_PRESIGN_TTL_SECONDS=3600

# Crawler tuning
RECURSIVE_LIMIT=3
HEADLESS=false
SLOW_MO_MS=400
NAV_TIMEOUT_MS=15000
NETWORK_IDLE_TIMEOUT_MS=5000
ACTION_TIMEOUT_MS=5000

# DOM-based detection / interaction policy
MAX_ELEMENTS_PER_STATE=15
MAX_SIBLING_GROUP=5
SAME_ORIGIN_ONLY=true
VISION_FALLBACK=true
DENY_TEXT_PATTERNS=logout,log out,sign out,delete account

# Form handling (dummy inputs + combination cap)
FORM_DUMMY_TEXT=Automated crawler input
FORM_DUMMY_EMAIL=qa.crawler@example.com
FORM_DUMMY_NUMBER=42
FORM_DUMMY_PHONE=5551234567
FORM_DUMMY_DATE=2026-01-15
MAX_FORM_COMBINATIONS=24
